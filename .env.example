# 容器外使用127.0.0.1，容器内使用postgres，Redis使用redis，Milvus使用milvus，RustFS使用rustfs，RocketMQ使用rocketmq-namesrv

# 数据库配置
DB_HOST=postgres
DB_PORT=5432
DB_NAME=simple_rag
DB_USERNAME=postgres
DB_PASSWORD=your_password_here

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis

# AI 模型配置
BAILIAN_API_KEY=your_bailian_api_key_here
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# AI 模型地址配置
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation
BAILIAN_MODEL=qwen-plus
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1/chat/completions
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:1.5b

# Embedding 服务配置
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_SILICONFLOW_API_KEY=your_siliconflow_api_key_here
EMBEDDING_SILICONFLOW_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1/embeddings
EMBEDDING_BAILIAN_API_KEY=your_bailian_api_key_here
EMBEDDING_BAILIAN_MODEL=text-embedding-v4
EMBEDDING_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding
EMBEDDING_OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_OLLAMA_MODEL=bge-large-zh

# Reranker 配置
RERANKER_API_KEY=your_siliconflow_api_key_here
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_BASE_URL=https://api.siliconflow.cn/v1/rerank
RERANKER_TOP_N=4
RERANKER_SCORE_THRESHOLD=0.3

# Milvus 向量数据库配置
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_VECTOR_DIMENSION=1024

# RustFS 对象存储配置
RUSTFS_ENDPOINT=http://rustfs:9000
RUSTFS_ACCESS_KEY=your_rustfs_access_key_here
RUSTFS_SECRET_KEY=your_rustfs_secret_key_here
RUSTFS_BUCKET=simple-rag

# RocketMQ 配置
ROCKETMQ_NAME_SERVER=rocketmq-namesrv:9876
ROCKETMQ_PRODUCER_GROUP=simple-rag-producer
ROCKETMQ_CONSUMER_GROUP=simple-rag-consumer
ROCKETMQ_CONSUMER_TAG=*
ROCKETMQ_CHUNK_TOPIC=knowledge-chunk-topic

# SA-Token 配置
SA_TOKEN_NAME=satoken
SA_TOKEN_TIMEOUT=86400
SA_TOKEN_ACTIVE_TIMEOUT=1800
SA_TOKEN_CONCURRENT=true
SA_TOKEN_SHARE=true
SA_TOKEN_STYLE=uuid
SA_TOKEN_READ_COOKIE=false
SA_TOKEN_READ_HEADER=true

# 服务器配置
SERVER_PORT=9092
SERVER_CONTEXT_PATH=/api/simple-rag

# 联网搜索配置
WEB_SEARCH_ENABLED=true
WEB_SEARCH_SCORE_THRESHOLD=0.02
WEB_SEARCH_TOP_K=5

# MCP 搜索工具配置
TAVILY_API_KEY=your_tavily_api_key_here

# 邮件配置
MAIL_HOST=smtp.163.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=