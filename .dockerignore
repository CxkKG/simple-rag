# 忽略依赖文件
node_modules/
target/
.idea/
*.iml
.git/

# 忽略本地配置
.env
config/

# 忽略日志文件
*.log
logs/

# 忽略操作系统文件
.DS_Store
Thumbs.db

# 忽略前端开发文件 (生产构建不需要)
frontend/src/
frontend/public/
frontend/node_modules/
frontend/*.config.js
frontend/*.config.ts
frontend/tsconfig.json
frontend/package-lock.json
frontend/yarn.lock
